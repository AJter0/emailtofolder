{
  "manifest_version": 3,
  "name": "Email to Folder — Gmail & Outlook Auto Archiver",
  "short_name": "Email to Folder",
  "version": "1.0.0",
  "description": "จัดเก็บอีเมล Gmail และ Outlook / Office 365 ลงโฟลเดอร์อัตโนมัติตามกฎ พร้อมแยกไฟล์แนบ — ประมวลผลในเบราว์เซอร์ 100%",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Email to Folder",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "identity",
    "downloads",
    "downloads.ui",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/gmail.js"],
      "css": ["content/fab.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ],
      "js": ["content/outlook.js"],
      "css": ["content/fab.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "116"
}
